setwd("D:/data")
data<-read.csv("cps4_small.csv",header = TRUE)
attach(data)
data
model1<-lm(wage~educ)
model1
res<-model1$residuals
plot(educ,res)
data1<-subset(data,female==0)
attach(data1)
data1<-subset(data,male==1)
attach(data1)
model2<-lm(wage~educ)
model2
attach(data)
educ2<-educ^2
model3<-lm(wage~educ2)
summary(model3)
model4<-lm(wage~exper)
model4
plot(wage,exper)
attach(data)
model4<-lm(wage~exper)
summary(model4)
confint(model4,level = 0.95)
res<-model4$residuals
plot(exper,res)
lwage<-log(wage)
model5<-lm(lwage~educ+exper+hrswk)
summary(model5)
confint(model5, level = 0.95)[2,2]
qt(0.9, 996)
model5$coefficients[2]
model5$coefficients
attach(data)
lwage<-log(wage)
educ2<-educ*exper
exper2<-educ^2
hrswk2<-exper^2
model6<-lm(wage~educ2+exper2+hrswk2)
summary(model6)
